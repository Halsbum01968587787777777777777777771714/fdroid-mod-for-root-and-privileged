    <string name="pref_install_method_standard_summary">Android चे अंगभूत इंस्टॉलर. पुष्टी मागते.</string>
    <string name="pref_install_method_privileged">F-Droid Privileged Extension</string>
    <string name="pref_install_method_privileged_summary">Privileged Extension (सिस्टम अॅप किंवा Magisk मॉड्यूल) द्वारे शांतपणे इंस्टॉल. उपलब्ध नसल्यास मानक इंस्टॉलर वापरले जाते.</string>
    <string name="pref_install_method_root">Root (Magisk)</string>
    <string name="pref_install_method_root_summary">root अधिकारांसह शांतपणे इंस्टॉल (Magisk, KernelSU). root नाकारले गेल्यास मानक इंस्टॉलर वापरले जाते.</string>
    <string name="pref_install_method_root_ok">root अॅक्सेस दिला आहे</string>
    <string name="pref_install_method_root_failed">root अॅक्सेस नाकारला गेला किंवा उपलब्ध नाही. मानक इंस्टॉलर वापरले जात आहे.</string>
    <string name="pref_install_method_privileged_ok">Privileged Extension सापडले आणि तयार आहे</string>
    <string name="pref_install_method_privileged_not_installed">Privileged Extension इंस्टॉल केलेले नाही. मानक इंस्टॉलर वापरले जात आहे.</string>
    <string name="pref_install_method_privileged_not_allowed">Privileged Extension इंस्टॉल केलेले आहे, परंतु त्याला सिस्टम विशेषाधिकार नाहीत किंवा ते या अॅपच्या स्वाक्षरीवर विश्वास ठेवत नाही. मानक इंस्टॉलर वापरले जात आहे.</string>
    <string name="pref_install_method_shizuku">Shizuku</string>
    <string name="pref_install_method_shizuku_summary">Shizuku द्वारे शांतपणे इंस्टॉल (Shizuku चालू असले पाहिजे आणि अॅक्सेस दिलेला असला पाहिजे). उपलब्ध नसल्यास मानक इंस्टॉलर वापरले जाते.</string>
    <string name="pref_install_method_shizuku_ok">Shizuku तयार आहे</string>
    <string name="pref_install_method_shizuku_not_running">Shizuku इंस्टॉल केलेले नाही किंवा चालू नाही. मानक इंस्टॉलर वापरले जात आहे.</string>
    <string name="pref_install_method_shizuku_denied">Shizuku चा अॅक्सेस नाकारला गेला. Shizuku अॅपमध्ये F-Droid ला परवानगी द्या. मानक इंस्टॉलर वापरले जात आहे.</string>
    <string name="pref_install_method_shizuku_old">इंस्टॉल केलेली Shizuku आवृत्ती खूप जुनी आहे. मानक इंस्टॉलर वापरले जात आहे.</string>
    <string name="pref_install_method_dhizuku">Dhizuku</string>
    <string name="pref_install_method_dhizuku_summary">Dhizuku द्वारे डिव्हाइस मालक म्हणून शांतपणे इंस्टॉल (Dhizuku सेट केलेले असले पाहिजे आणि अॅक्सेस दिलेला असला पाहिजे). उपलब्ध नसल्यास मानक इंस्टॉलर वापरले जाते.</string>
    <string name="pref_install_method_dhizuku_ok">Dhizuku तयार आहे</string>
    <string name="pref_install_method_dhizuku_not_available">Dhizuku इंस्टॉल केलेले नाही किंवा सक्रिय नाही. मानक इंस्टॉलर वापरले जात आहे.</string>
    <string name="pref_install_method_dhizuku_denied">Dhizuku चा अॅक्सेस नाकारला गेला. मानक इंस्टॉलर वापरले जात आहे.</string>
    <string name="pref_install_method_microg">microG</string>
    <string name="pref_install_method_microg_summary">microG Companion च्या इंस्टॉलरद्वारे इंस्टॉल करते. microG Companion आवश्यक आहे, आणि microG तरीही डायलॉग दाखवू शकते. उपलब्ध नसल्यास मानक इंस्टॉलर वापरले जाते.</string>
    <string name="pref_install_method_microg_ok">microG Companion सापडले</string>
    <string name="pref_install_method_microg_not_available">इंस्टॉल सपोर्ट असलेले microG Companion सापडले नाही. मानक इंस्टॉलर वापरले जात आहे.</string>
    <string name="pref_install_method_external">दुसरे इंस्टॉलर अॅप</string>
    <string name="pref_install_method_external_summary">पॅकेजच्या नावानुसार APK दुसऱ्या इंस्टॉलर अॅपला देते (उदा. App Manager). उपलब्ध नसल्यास मानक इंस्टॉलर वापरले जाते.</string>
    <string name="pref_install_method_external_ok">इंस्टॉलर अॅप सापडले</string>
    <string name="pref_install_method_external_no_package">पॅकेजचे नाव दिलेले नाही. तुम्ही एक सेट करेपर्यंत मानक इंस्टॉलर वापरले जाईल.</string>
    <string name="pref_install_method_external_not_installed">हे अॅप इंस्टॉल केलेले नाही. तुम्ही पॅकेजचे नाव दुरुस्त करेपर्यंत मानक इंस्टॉलर वापरले जाईल.</string>
    <string name="pref_install_method_external_cannot_install">हे अॅप APK फाइल्स इंस्टॉल करू शकत नाही. तुम्ही दुसरे निवडेपर्यंत मानक इंस्टॉलर वापरले जाईल.</string>
