    <string name="pref_install_method_title">ინსტალაციის მეთოდი</string>
    <string name="pref_install_method_standard">სტანდარტული (სისტემა)</string>
    <string name="pref_install_method_standard_summary">Android-ის ჩაშენებული ინსტალერი. ითხოვს დადასტურებას.</string>
    <string name="pref_install_method_privileged">F-Droid Privileged Extension</string>
    <string name="pref_install_method_privileged_summary">ჩუმი ინსტალაცია Privileged Extension-ის მეშვეობით (სისტემური აპი ან Magisk-ის მოდული). თუ მიუწვდომელია, გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_install_method_root">Root (Magisk)</string>
    <string name="pref_install_method_root_summary">ჩუმი ინსტალაცია root უფლებებით (Magisk, KernelSU). თუ root უარყოფილია, გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_install_method_root_ok">root წვდომა მიცემულია</string>
    <string name="pref_install_method_root_failed">root წვდომა უარყოფილია ან მიუწვდომელია. გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_install_method_privileged_ok">Privileged Extension ნაპოვნია და მზადაა</string>
    <string name="pref_install_method_privileged_not_installed">Privileged Extension დაინსტალირებული არ არის. გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_install_method_privileged_not_allowed">Privileged Extension დაინსტალირებულია, მაგრამ არ აქვს სისტემური პრივილეგიები ან არ ენდობა ამ აპის ხელმოწერას. გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_install_method_shizuku">Shizuku</string>
    <string name="pref_install_method_shizuku_summary">ჩუმი ინსტალაცია Shizuku-ს მეშვეობით (Shizuku უნდა მუშაობდეს და წვდომა უნდა იყოს მიცემული). თუ მიუწვდომელია, გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_install_method_shizuku_ok">Shizuku მზადაა</string>
    <string name="pref_install_method_shizuku_not_running">Shizuku დაინსტალირებული არ არის ან არ მუშაობს. გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_install_method_shizuku_denied">Shizuku-ზე წვდომა უარყოფილია. ნება დართეთ F-Droid-ს Shizuku-ს აპში. გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_install_method_shizuku_old">დაინსტალირებული Shizuku-ს ვერსია ძალიან ძველია. გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_install_method_dhizuku">Dhizuku</string>
    <string name="pref_install_method_dhizuku_summary">ჩუმი ინსტალაცია მოწყობილობის მფლობელის სახით Dhizuku-ს მეშვეობით (Dhizuku უნდა იყოს მორგებული და წვდომა მიცემული). თუ მიუწვდომელია, გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_install_method_dhizuku_ok">Dhizuku მზადაა</string>
    <string name="pref_install_method_dhizuku_not_available">Dhizuku დაინსტალირებული არ არის ან აქტიური არ არის. გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_install_method_dhizuku_denied">Dhizuku-ზე წვდომა უარყოფილია. გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_install_method_microg">microG</string>
    <string name="pref_install_method_microg_summary">ინსტალაცია microG Companion-ის ინსტალერის მეშვეობით. საჭიროა microG Companion და microG მაინც შეიძლება აჩვენებდეს დიალოგს. თუ მიუწვდომელია, გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_install_method_microg_ok">microG Companion ნაპოვნია</string>
    <string name="pref_install_method_microg_not_available">microG Companion ინსტალაციის მხარდაჭერით ვერ მოიძებნა. გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_install_method_external">სხვა ინსტალერის აპი</string>
    <string name="pref_install_method_external_summary">გადასცემს APK-ს სხვა ინსტალერის აპს პაკეტის სახელით (მაგ. App Manager). თუ მიუწვდომელია, გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_install_method_external_ok">ინსტალერის აპი ნაპოვნია</string>
    <string name="pref_install_method_external_no_package">პაკეტის სახელი შეყვანილი არ არის. სანამ არ მიუთითებთ, გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_install_method_external_not_installed">ეს აპი დაინსტალირებული არ არის. სანამ პაკეტის სახელს არ გაასწორებთ, გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_install_method_external_cannot_install">ეს აპი ვერ აინსტალირებს APK ფაილებს. სანამ სხვას არ აირჩევთ, გამოიყენება სტანდარტული ინსტალერი.</string>
    <string name="pref_external_installer_title">ინსტალერის აპის პაკეტის სახელი</string>
    <string name="pref_external_installer_empty">არ არის მითითებული</string>
    <string name="pref_external_installer_hint">მაგალითად, io.github.muntashirakon.AppManager</string>
    <string name="pref_external_installer_error">ეს პაკეტის ვალიდური სახელი არ არის</string>
